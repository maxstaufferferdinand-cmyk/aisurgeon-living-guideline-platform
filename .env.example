# Never place real keys or credentials in this versioned template.
# Keep one local .env per laptop and never commit that local file.
# Configure laptop-specific paths here; never change Python code for local paths.

AISURGEON_WORKER_ID=
AISURGEON_DATA_ROOT=
AISURGEON_PDF_SOURCE_DIR=
AISURGEON_RUNS_DIR=
AISURGEON_CACHE_DIR=
AISURGEON_EXPORTS_DIR=
AISURGEON_LOGS_DIR=

GEMINI_API_KEY=
OPENAI_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=

# V3 provider preflight and live pilot controls. Leave unset for mocked tests.
AISURGEON_PROVIDER_PREFLIGHT_ASSERTION=
AISURGEON_GEMINI_DEFAULT_CONCURRENCY=1
